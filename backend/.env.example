CI_ENVIRONMENT = development

app.baseURL = 'http://localhost:8090/'
app.forceGlobalSecureRequests = false

database.default.hostname = db
database.default.database = stu430
database.default.username = stu430
database.default.password = stu430pass
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Sal del hash HMAC-SHA256 usado para buscar empleados por DNI.
# Cámbiala por una larga y aleatoria. Si la cambias, vuelve a ejecutar la
# migración de rehash o los DNI existentes dejarán de encontrarse.
FIRMA_HASH_SALT = 'cambia-esta-sal-por-otra-larga-y-secreta'

# Clave maestra AES-256-GCM en base64 (32 bytes). Genera una con:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
FIRMA_AES_KEY = 'genera-una-clave-aleatoria-base64-de-32-bytes'

# Solo para migraciones históricas que cifraban el DNI con AES-256-CBC.
# El flujo actual no la usa.
HASH_SALT = 'cambia-esta-sal-por-una-larga-y-secreta'
